{
  "name": "page-builder-example",
  "version": "1.0.0",
  "private": true,
  "description": "Example: building a Sanity page builder with sanity-plugin-section-builder (Studio) + sanity-page-builder-core (Next.js frontend).",
  "license": "MIT",
  "author": "Maciej Trzciński",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "page-builder",
    "nextjs",
    "cms",
    "tailwindcss",
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/page-builder-example.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/page-builder-example/issues"
  },
  "homepage": "https://github.com/OWNER/page-builder-example#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "predev": "pnpm typegen",
    "dev": "next dev",
    "prebuild": "pnpm typegen",
    "build": "next build",
    "start": "next start",
    "pretype-check": "pnpm typegen",
    "type-check": "tsc --noEmit",
    "extract-schema": "sanity schema extract --path schema.json --force",
    "typegen": "sanity schema extract --path schema.json --force && sanity typegen generate",
    "seed": "node scripts/seed.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@maciejtrzcinski/sanity-page-builder-core": "^2.0.1",
    "@maciejtrzcinski/sanity-plugin-section-builder": "^1.1.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "next": "^16.4.6",
    "next-sanity": "^13.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.24.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.45.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
