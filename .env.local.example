# Copy to .env.local and fill in from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Absolute site URL used as metadataBase for canonical / og:url / sitemap (optional in dev)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shared secret for the Sanity revalidation webhook (POST /api/revalidate)
SANITY_REVALIDATE_SECRET="choose-a-strong-secret"

# Read token (sanity.io/manage → API → Tokens) enabling draft/preview reads in
# the Presentation tool. Published content works without it.
SANITY_VIEWER_TOKEN="your-viewer-token"
